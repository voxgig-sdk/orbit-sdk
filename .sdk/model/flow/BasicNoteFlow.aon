# BasicNoteFlow

main: kit: flow: BasicNoteFlow:
{
  entity: "note",
  kind: "basic",
  name: "BasicNoteFlow",
  step: [
    {
      input: {
        ref: "note_ref01"
      }

      match: {
        member_id: "member01",
        member_slug: "member_slug01",
        workspace_slug: "workspace_slug01"
      }

      op: "create"
    }

    {
      data: {
        member_id: "member01",
        workspace_slug: "workspace_slug01"
      }

      input: {
        ref: "note_ref01",
        srcdatavar: "note_ref01_data",
        suffix: "_up0",
        textfield: "body"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-note_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "note_ref01",
        srcdatavar: "note_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "note01",
        workspace_slug: "workspace_slug01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-note_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNoteFlow"
}