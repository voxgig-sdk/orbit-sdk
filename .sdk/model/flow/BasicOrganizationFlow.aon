# BasicOrganizationFlow

main: kit: flow: BasicOrganizationFlow:
{
  entity: "organization",
  kind: "basic",
  name: "BasicOrganizationFlow",
  step: [
    {
      data: {
        workspace_slug: "workspace_slug01"
      }

      input: {
        ref: "organization_ref01",
        srcdatavar: "organization_ref01_data",
        suffix: "_up0",
        textfield: "crm_uid"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-organization_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "organization_ref01",
        srcdatavar: "organization_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "organization01",
        workspace_slug: "workspace_slug01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-organization_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOrganizationFlow"
}