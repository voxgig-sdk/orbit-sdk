# BasicMemberFlow

main: kit: flow: BasicMemberFlow:
{
  entity: "member",
  kind: "basic",
  name: "BasicMemberFlow",
  step: [
    {
      input: {
        ref: "member_ref01"
      }

      match: {
        workspace_slug: "workspace_slug01"
      }

      op: "create"
    }

    {
      data: {
        workspace_slug: "workspace_slug01"
      }

      input: {
        ref: "member_ref01",
        srcdatavar: "member_ref01_data",
        suffix: "_up0",
        textfield: "bio"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-member_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "member_ref01",
        srcdatavar: "member_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "member01",
        workspace_slug: "workspace_slug01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-member_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "member_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "member01",
        workspace_slug: "workspace_slug01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicMemberFlow"
}